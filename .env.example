# KingdomFlow Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Application URL (update after Vercel deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TextBee SMS Gateway (get from https://textbee.dev)
# Stored encrypted in the database per-organization, not as env var
# TEXTBEE_API_KEY=your_textbee_api_key

# Google OAuth for Gmail sending
# Set up at https://console.cloud.google.com
# Enable Gmail API and create OAuth 2.0 credentials
# Add your app URL to authorized redirect URIs
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
